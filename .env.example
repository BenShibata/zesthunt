# Copy to .env.local for local development. Never commit real keys.
# With no keys set, the app runs in demo mode on fictional mock places.

# Google Maps Platform key with these APIs enabled:
#   Places API (New), Geocoding API (and Routes API if USE_ROUTES_API=true)
# Restrict it to those APIs. It is only ever used server-side.
GOOGLE_MAPS_API_KEY=

# Anthropic API key for ranking and describing picks.
# Without it, picks use simple on-server descriptions based on place type.
ANTHROPIC_API_KEY=

# Optional: which model ranks picks. haiku (default, cheapest), sonnet, opus,
# off (free rule-based picks, no AI), or any full model ID.
# ANTHROPIC_MODEL=haiku

# Optional: true pays for Google Routes walk/drive times. Off by default: times are
# estimated from distance (shown with "~"), which costs nothing.
# USE_ROUTES_API=false

# Hunt party rooms. Required on Vercel (instances don't share memory); without these,
# rooms live in local process memory, which is fine for `npm run dev`.
# Rooms hold only a code, nicknames, restaurant cards and swipes, and expire 10 minutes after creation.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: most live place searches the AI assistant connector (/mcp) may run per UTC day,
# across all callers. Each one calls Places (and Routes, if enabled). Default 2000.
# MCP_DAILY_LIMIT=2000

# ---------------------------------------------------------------------------
# Revenue (optional). Nothing changes until these are set.
# ---------------------------------------------------------------------------

# Referral tags for links out, from each partner's affiliate program. Either a tracking
# link with {url} where the destination goes (Impact/CJ style), or plain parameters to
# append. Exposed to the browser (they're in the links), so never put a secret here.
# NEXT_PUBLIC_REFERRAL_DOORDASH=https://doordash.pxf.io/c/XXXX/YYYY/ZZZZ?u={url}
# NEXT_PUBLIC_REFERRAL_UBEREATS=https://ubereats.pxf.io/c/XXXX/YYYY/ZZZZ?u={url}
# NEXT_PUBLIC_REFERRAL_OPENTABLE=ref=XXXX

# Sponsored deals: restaurants that pay to show a deal on their own card (labeled
# "Sponsored", never ranked higher). JSON list; placeId is the Google place ID.
# SPONSORS=[{"placeId":"ChIJ...","deal":"10% off with code ZEST","url":"https://example.com","until":"2026-12-31"}]
